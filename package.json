{
  "name": "oasis-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "build:core": "npm run build --workspace=@oasis/ai-core",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:core && npm run build:backend"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}

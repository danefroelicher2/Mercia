{
  "name": "mercia-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend",
    "build:core": "npm run build --workspace=@mercia/ai-core",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:core && npm run build:backend"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "expo": "^54.0.33"
  }
}
